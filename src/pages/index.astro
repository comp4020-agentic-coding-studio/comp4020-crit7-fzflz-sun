---
import { listTimetable } from "../lib/db";
import { layoutDay } from "../lib/layout";
import "../styles.css";

// Gated by src/middleware.ts: an unauthenticated request never reaches this
// render (redirected to /login first), so locals.user is always set here.
const user = Astro.locals.user!;

const DAY_LABELS = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"];
const DAY_START = 8 * 60; // 08:00
const DAY_END = 18 * 60; // 18:00

// Single source of truth for the whole grid's vertical scale: every other
// pixel measurement on the page (day height, hour-gridline spacing, card
// top/height) is derived from this one number, so they can't drift apart.
// 1.8 gives a 60-minute session ~108px — enough for its five lines of text
// (status, course code, activity type, time, location/seats) at the card's
// tightened line-height without clipping, even split three-wide. Session
// cards use this as their actual height (not a min-height): a card's size
// must always represent its real duration, so it never visually overflows
// into a neighbouring time slot when content wraps under a narrow column —
// see .session-card and its container-query compact mode in styles.css.
const PX_PER_MINUTE = 1.8;

const sessions = listTimetable(user.id);

const days = DAY_LABELS.map((label, dayOfWeek) => ({
  label,
  sessions: layoutDay(sessions.filter((s) => s.dayOfWeek === dayOfWeek)),
}));

const courseLegend = [...new Map(sessions.map((s) => [s.courseCode, s.courseColor])).entries()].sort(
  ([a], [b]) => a.localeCompare(b),
);

function formatTime(minutes: number): string {
  const h = Math.floor(minutes / 60);
  const m = minutes % 60;
  return `${h.toString().padStart(2, "0")}:${m.toString().padStart(2, "0")}`;
}

const hourMarks = Array.from(
  { length: (DAY_END - DAY_START) / 60 + 1 },
  (_, i) => DAY_START + i * 60,
);
const dayHeightPx = (DAY_END - DAY_START) * PX_PER_MINUTE;
const hourHeightPx = 60 * PX_PER_MINUTE;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Your ANU timetable</title>
  </head>
  <body>
    <nav class="site-nav" aria-label="site">
      <a href="/">Timetable</a>
      <a href="/readme/">About</a>
      <span class="site-nav-user">Signed in as {user.displayName}</span>
      <form method="post" action="/api/logout" class="logout-form">
        <button type="submit">Log out</button>
      </form>
    </nav>
    <main>
      <h1>Your ANU timetable</h1>
      <p class="intro">
        Pick your sessions directly on the timetable — no separate allocation
        table to cross-reference. Select a dashed session to allocate it;
        select your solid allocated session again to remove it. Only your own
        enrolled courses are shown; seat counts are shared with every other
        student.
      </p>
      <ul class="legend" aria-label="legend">
        <li class="legend-item legend-available">Available</li>
        <li class="legend-item legend-allocated">Allocated</li>
        <li class="legend-item legend-full">Full</li>
      </ul>
      {
        courseLegend.length > 0 && (
          <ul class="course-legend" aria-label="your courses">
            {courseLegend.map(([code, color]) => (
              <li class="course-legend-item" style={`--course-color:${color}`}>
                {code}
              </li>
            ))}
          </ul>
        )
      }
      <p id="status" role="status" aria-live="polite"></p>
      <p id="scroll-hint" class="scroll-hint">Swipe horizontally to see the whole week.</p>
      <div class="timetable-scroll" aria-describedby="scroll-hint">
        <div class="timetable" style={`--day-height:${dayHeightPx}px; --hour-height:${hourHeightPx}px`}>
          <div class="hour-axis">
            <div class="hour-axis-spacer"></div>
            <div class="hour-marks">
              {
                hourMarks.map((minute) => (
                  <div class="hour-label" style={`top:${(minute - DAY_START) * PX_PER_MINUTE}px`}>
                    {formatTime(minute)}
                  </div>
                ))
              }
            </div>
          </div>
          {
            days.map((day) => (
              <div class="day-column">
                <div class="day-heading">{day.label}</div>
                <div class="day-body">
                  {day.sessions.map((session) => {
                    const top = (session.startMinutes - DAY_START) * PX_PER_MINUTE;
                    const height = (session.endMinutes - session.startMinutes) * PX_PER_MINUTE;
                    const width = 100 / session.columnCount;
                    const left = session.column * width;
                    const remaining = session.capacity - session.allocatedCount;
                    const statusLabel =
                      session.status === "allocated"
                        ? "Allocated"
                        : session.status === "full"
                          ? "Full"
                          : "Available";
                    // Spelled out in the label too, not just implied by
                    // aria-pressed, so a screen-reader user hears how to act
                    // on this card without depending on the intro paragraph.
                    const actionHint =
                      session.status === "allocated"
                        ? "select again to cancel"
                        : session.status === "full"
                          ? "full, not selectable"
                          : "select to allocate";
                    return (
                      <button
                        type="button"
                        class={`session-card status-${session.status}`}
                        style={`top:${top}px; height:${height}px; left:${left}%; width:${width}%; --course-color:${session.courseColor}`}
                        data-session-id={session.id}
                        disabled={session.status === "full"}
                        aria-pressed={
                          session.status === "full"
                            ? undefined
                            : session.status === "allocated"
                              ? "true"
                              : "false"
                        }
                        aria-label={`${session.courseCode} ${session.activityType}, ${formatTime(session.startMinutes)} to ${formatTime(session.endMinutes)}, ${session.location}, ${statusLabel}, ${remaining} of ${session.capacity} seats remaining, ${actionHint}`}
                      >
                        <span class="card-status">{statusLabel}</span>
                        <span class="card-course-activity">
                          <span class="card-course">{session.courseCode}</span>
                          <span class="card-activity">{session.activityType}</span>
                        </span>
                        <span class="card-time">
                          {formatTime(session.startMinutes)}–{formatTime(session.endMinutes)}
                        </span>
                        <span class="card-meta">
                          {session.location} · {remaining}/{session.capacity} seats
                        </span>
                      </button>
                    );
                  })}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </main>
    <script>
      // Progressive enhancement, guestbook-style: the grid above is already
      // fully server-rendered with the correct state. This script only wires
      // up the click → fetch → reload round trip; the server stays the only
      // place that decides what "allocated" or "full" means.
      const grid = document.querySelector(".timetable");
      const status = document.querySelector("#status");

      grid?.addEventListener("click", async (event) => {
        const button = (event.target as HTMLElement).closest<HTMLButtonElement>(
          "button[data-session-id]",
        );
        if (!button || button.disabled) return;

        const sessionId = Number(button.dataset.sessionId);
        const isAllocated = button.getAttribute("aria-pressed") === "true";
        button.disabled = true;
        if (status) {
          status.textContent = isAllocated ? "Removing allocation…" : "Saving allocation…";
        }

        try {
          const res = await fetch("/api/allocations", {
            method: isAllocated ? "DELETE" : "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({ sessionId }),
          });
          if (!res.ok) {
            const body = await res.json().catch(() => ({ error: "unknown" }));
            if (status) {
              status.textContent =
                body.error === "full"
                  ? "That session just filled up — pick another."
                  : body.error === "already-allocated"
                    ? "You already hold a session for this activity — cancel it first."
                    : body.error === "not-enrolled"
                      ? "You're not enrolled in this course."
                      : body.error === "unauthenticated"
                        ? "Your session has expired — reload to log in again."
                        : "Couldn't save that. Try again.";
            }
            button.disabled = false;
            return;
          }
          window.location.reload();
        } catch {
          if (status) status.textContent = "Network error — try again.";
          button.disabled = false;
        }
      });
    </script>
  </body>
</html>
